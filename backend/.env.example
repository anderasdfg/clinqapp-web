# Server Configuration
PORT=3001
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Cloud Scheduler / reminders shared secret (header: X-Scheduler-Secret)
SCHEDULER_SECRET=change-me-scheduler-secret

# One-off migration endpoint secret (header: X-Migration-Secret). Blocked in production without this.
MIGRATION_SECRET=change-me-migration-secret

# Admin panel (bcrypt hash of password + JWT signing secret)
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$replaceWithRealBcryptHash
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=8h

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_REMINDER_CONTENT_SID=your-twilio-content-sid
